# ==========================================
# POKA Autonomous Economic Agreement Agent
# Environment Configuration
# ==========================================

# Port for backend API
PORT=3001

# Toggle Demo Sandbox Mode vs Live Celo Sepolia
# Set to 'false' to broadcast live transactions to Celo Sepolia
DEMO_MODE=true

# Celo Sepolia Network RPC
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Wallet Private Key for Autonomous Escrow Signer (NEVER commit real keys)
# Must start with 0x
CELO_PRIVATE_KEY=

# Celo Hackathon Attribution Tag (assigned via Celo Builders registration)
CELO_ATTRIBUTION_TAG=poka-agent-work-v1

# Optional AI LLM Provider Key (Defaults to deterministic regex/NLP parser if not set)
AI_API_KEY=

# Database configuration (Defaults to lightweight in-memory/sqlite store)
DATABASE_URL=
